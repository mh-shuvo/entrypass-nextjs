model Event {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(100)
  description String?      @db.Text
  startDate   DateTime?
  endDate     DateTime?
  regStart    DateTime?
  regEnd      DateTime?
  status      EVENT_STATUS @default(DRAFT)
  venue       String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  event_slug  String       @unique @db.VarChar(110)
  media       EventMedia[] @relation("EventMediaOwner")
  banner      EventMedia?  @relation("EventBanner")

  @@map("events")
}

model EventMedia {
  id               Int              @id @default(autoincrement())
  eventId          Int
  kind             EVENT_MEDIA_KIND
  bannerForEventId Int?             @unique
  storageKey       String           @unique @db.VarChar(512)
  originalName     String           @db.VarChar(255)
  mimeType         String           @db.VarChar(191)
  sizeBytes        Int
  createdAt        DateTime         @default(now())
  event            Event            @relation("EventMediaOwner", fields: [eventId], references: [id], onDelete: Cascade)
  bannerForEvent   Event?           @relation("EventBanner", fields: [bannerForEventId], references: [id], onDelete: Cascade)

  @@index([eventId, kind])
  @@map("event_media")
}
