model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  name      String?
  password  String
  UserType  UserType   @default(EXECUTIVE)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  @@map("users")
}
